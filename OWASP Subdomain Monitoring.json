        352
      ],
      "id": "96de5f26-4551-4b46-817d-f189b20c5623",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst raw = $json.output;\n\nconst cleaned = raw\n  .replace(/```json\\s*/i, '')\n  .replace(/```\\s*/g, '')\n  .trim();\n\nconst result = JSON.parse(cleaned);\n\nreturn {\n  json: result\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        144
      ],
      "id": "507b32d6-1d84-43b9-b3d1-f07babac578e",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "76942413-bd26-4db5-bd7e-f623eeaf6486",
              "rightValue": 2,
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ Number($json.priority) }}"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        1152,
        144
      ],
      "id": "642a2152-6933-4e71-9abd-f31b360f67c6",
      "name": "Filter"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nconst groups = {};\n\nfor (const item of items) {\n  const { hostname, tag, priority, reason } = item.json;\n\n  if (!groups[tag]) {\n    groups[tag] = [];\n  }\n\n  groups[tag].push({\n    hostname,\n    priority,\n    reason,\n  });\n}\n\nlet report = 'OWASP Subdomain Monitoring Report\\n\\n';\n\nfor (const tag of Object.keys(groups).sort()) {\n  report += `## ${tag.toUpperCase()}\\n`;\n\n  for (const host of groups[tag]) {\n    report += `- ${host.hostname} | Priority: ${host.priority} | ${host.reason}\\n`;\n  }\n\n  report += '\\n';\n}\n\nreturn [{\n  json: {\n    report,\n    totalHostnames: items.length,\n    groups,\n  },\n}];\n"
      },
