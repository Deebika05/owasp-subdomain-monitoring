      "typeVersion": 4.5,
      "position": [
        160,
        128
      ],
      "id": "738f8a80-4fbb-413a-923d-540d4f055105",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\n// Get host records returned by the API\nconst hosts = response.hosts || [];\n\n// Remove wildcard entries, normalize case, and deduplicate\nconst uniqueHosts = [\n  ...new Set(\n    hosts\n      .map(item => (item.host || '').trim().toLowerCase())\n      .filter(host =>\n        host &&\n        !host.startsWith('*.') &&\n        host !== 'owasp.org' &&\n        host.endsWith('.owasp.org')\n      )\n  )\n];\n\n// Return one n8n item per hostname\nreturn uniqueHosts.map(host => ({\n  json: {\n    hostname: host\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        144
      ],
      "id": "b1dbc13f-4a82-4424-a78a-f579db51bf89",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify the hostname provided below. Do not ask the user for more information.\n\nHostname to classify:\n{{ $json.hostname }}\n\nChoose exactly one tag: admin, dev, staging, api, other.\n\nAssign a priority:\n1 = Low review priority\n2 = Worth reviewing\n3 = Moderate review priority\n4 = High review priority\n5 = Highest review priority\n\nUse only the hostname as evidence. Do not claim a vulnerability based on the hostname alone.\n\nReturn only one valid JSON object, without Markdown or additional text, using this exact structure:\n{\n  \"hostname\": \"{{ $json.hostname }}\",\n  \"tag\": \"other\",\n  \"priority\": 2,\n  \"reason\": \"Brief explanation based on the hostname.\"\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        608,
        208
      ],
      "id": "4c60973e-1878-4521-bfbc-b842034f8a93",
      "name": "AI Agent"
    },
    {
      "parameters": {
